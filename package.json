{
  "name": "@item-enonic-types/lib-cloudflare-turnstile",
  "version": "1.0.0",
  "description": "Type definitions for lib-cloudflare-turnstile",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-cloudflare-turnstile.git"
  },
  "peerDependencies": {
    "@enonic-types/core": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/core": "^8.0.4",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-http-client": "^4.0.1",
    "@enonic-types/lib-portal": "^8.0.4",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "biome check src/main/resources/lib/cloudflare-turnstile",
    "format": "biome check --write src/main/resources/lib/cloudflare-turnstile",
    "prepublishOnly": "tsc -p src/main/resources/tsconfig.json --declaration true --emitDeclarationOnly true --declarationDir dist",
    "postpublish": "rm -r ./dist",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs"
  }
}
